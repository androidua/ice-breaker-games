{
  "name": "huddle-play-room",
  "private": true,
  "version": "1.16.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "vite build && node server/index.js",
    "test": "node test/smoke-test.js",
    "test:unit": "node --test 'test/engines/**/*.test.js'",
    "test:integration": "node --test 'test/integration/**/*.test.js'",
    "test:all": "npm run test:unit && npm run test:integration && npm test",
    "verify-deploy": "node scripts/verify-deploy.js"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.4.10"
  }
}
