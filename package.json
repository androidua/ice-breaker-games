{
  "name": "huddle-play-room",
  "private": true,
  "version": "1.20.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "server": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "vite build && node server/index.js",
    "test": "node test/smoke-test.js",
    "test:unit": "node --test 'test/engines/**/*.test.js'",
    "test:integration": "node --test 'test/integration/**/*.test.js'",
    "test:all": "npm run test:unit && npm run test:integration && npm test",
    "install-hooks": "install -m 755 scripts/pre-push \"$(git rev-parse --git-common-dir)/hooks/pre-push\"",
    "verify-deploy": "node scripts/verify-deploy.js"
  },
  "dependencies": {
    "@sentry/node": "^10.75.0",
    "@sentry/react": "^10.75.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^6.4.3"
  }
}
